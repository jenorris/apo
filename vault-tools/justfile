# Apo vault-tools — contract-gated batch mutators for vault corpora.
# Prefer: just --justfile ~/Notes/<vault>/justfile … from outside the vault.
# Or: just -f vault-tools/justfile okf-lint --vault ~/Notes/Meta

set shell := ["bash", "-cu"]

tools := justfile_directory()
okf := tools / "tools" / "okf"

default:
    @just --list --justfile "{{ source_file() }}"

# OKF lint — shim over `apo-engine okf validate`.
# Usage: just okf-lint --vault ~/Notes/Meta [--profile okf] [path…]
okf-lint *args:
    python3 "{{ okf }}/okf_lint.py" {{ args }}

# OKF fix safe frontmatter gaps — shim over `apo-engine okf fix`.
okf-fix *args:
    python3 "{{ okf }}/okf_lint.py" --fix {{ args }}

# Regenerate index.md listings (implemented here; no OKF type logic).
okf-indexes *args:
    python3 "{{ okf }}/okf_lint.py" --regenerate-indexes {{ args }}

# Append ## OKF links
okf-linkify *args:
    python3 "{{ okf }}/okf_linkify.py" {{ args }}

# Export portable OKF subset — shim over `apo-engine okf export`.
okf-export *args:
    python3 "{{ okf }}/okf_export.py" {{ args }}
