# Apo — local profile (example)

# Copy to `.env` or merge into `config.env`, then edit paths.

# Prefer multi-vault discovery (see docs/multi-vault.md). APO_NOTES_ROOT remains
# the legacy single-vault fallback when no discovery env is set.
# APO_NOTES_ROOT="${APO_NOTES_ROOT:-$HOME/Notes/MyVault}"
# Canonical index location: ~/.apo (survives clean checkouts; multi-vault defaults there).
# APO_INDEX="${APO_INDEX:-$HOME/.apo/index.db}"
# Default embedder: Ollama bge-m3. Optional ONNX: fastembed + BAAI/bge-large-en-v1.5 (full reindex).
APO_EMBED_BACKEND="${APO_EMBED_BACKEND:-ollama}"
APO_MODEL="${APO_MODEL:-bge-m3}"
APO_OLLAMA_URL="${APO_OLLAMA_URL:-http://localhost:11434}"
OLLAMA_KEEP_ALIVE="${OLLAMA_KEEP_ALIVE:-5m}"
# MCP tool-use analytics DuckDB at ~/.apo/metrics.duckdb (0/false/off disables).
APO_TOOL_METRICS="${APO_TOOL_METRICS:-1}"
APO_INGEST_DIR="${APO_INGEST_DIR:-resources/wiki}"

# --- Multi-vault discovery (preferred) ---
# Parent directory of vaults (autoconfigure). Not a queue/telemetry id.
# Each immediate child with usage-contract vault_id is registered; Wiki-like
# siblings without vault_id are skipped.
# APO_COLLECTION_ROOT="$HOME/Notes"
# APO_DEFAULT_VAULT=jeremy
#
# Workbench / non-sibling roots — explicit paths only (never COLLECTION_ROOT=~/Notes):
# APO_VAULT_PATHS="$HOME/Notes/Work:$HOME/Notes/Contracts:$HOME/Notes/Optima:$HOME/Workbench/compliance"
# APO_DEFAULT_VAULT=work
#
# Compat (deprecated): APO_VAULTS JSON — roots only; keys/collection ignored;
# names come from usage-contract vault_id. Prefer COLLECTION_ROOT / VAULT_PATHS.
# APO_VAULTS="$HOME/.apo/vaults.json"

# Search quality (see docs/search-quality.md)
# Prefer per-vault system/contracts/search-contract.schema.yaml (default_exclude).
# APO_SEARCH_EXCLUDE="${APO_SEARCH_EXCLUDE:-}"

# Dotenv note: `just dotenv-load` does **not** expand ${HOME} / $HOME inside values.
# Prefer absolute paths in `.env`, or export vars from your shell profile.

# Watcher — MCP and watch must share the same discovery env.
APO_ENGINE_BIN="${APO_ENGINE_BIN:-$HOME/Code/apo/engine/.venv/bin/apo-engine}"
WATCH_INTERVAL="${WATCH_INTERVAL:-30}"
WATCH_RECONCILE_INTERVAL="${WATCH_RECONCILE_INTERVAL:-300}"
WATCH_PID_DIR="${WATCH_PID_DIR:-$HOME/.apo}"

# Local RPC (Laravel gateway / non-stdio clients) — see docs/local-rpc.md
# APO_RPC_HOST=127.0.0.1
# APO_RPC_PORT=8765
# APO_RPC_TOKEN=
# APO_RPC_SOCKET=
