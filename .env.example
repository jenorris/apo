# Apo — local profile (example)

# Copy to `.env`, then edit paths. `.env` is the one file everything reads:
# just (dotenv-load), watch.sh, launchd-watch.sh, apo-mcp.

# Prefer multi-vault discovery (see docs/multi-vault.md). APO_NOTES_ROOT remains
# the legacy single-vault fallback when no discovery env is set.
# APO_NOTES_ROOT="${APO_NOTES_ROOT:-$HOME/Notes/MyVault}"
# Canonical index location: ~/.apo (survives clean checkouts; multi-vault defaults there).
# APO_INDEX="${APO_INDEX:-$HOME/.apo/index.db}"
# Default embedder: Ollama bge-m3. Optional ONNX: fastembed + BAAI/bge-large-en-v1.5 (full reindex).
APO_EMBED_BACKEND="${APO_EMBED_BACKEND:-ollama}"
APO_MODEL="${APO_MODEL:-bge-m3}"
APO_OLLAMA_URL="${APO_OLLAMA_URL:-http://localhost:11434}"
OLLAMA_KEEP_ALIVE="${OLLAMA_KEEP_ALIVE:-5m}"
# llama.cpp server backend (GGUF models Ollama cannot load yet), e.g. EmbeddingGemma 2 at 512 dims.
# Run: llama-server -m embeddinggemma-2-F16.gguf --embeddings --port 8099 -c 8192 -b 8192 -ub 8192
# APO_EMBED_BACKEND=llamacpp  APO_LLAMACPP_URL=http://127.0.0.1:8099  APO_MODEL=embeddinggemma-2
# APO_EMBED_DIM=512  APO_DOC_PREFIX="title: none | text: "  APO_QUERY_PREFIX="task: search result | query: "
# Dimension and prefixes change the vectors: reindex (`index --rebuild`) after switching.
# MCP tool-use analytics (0/false/off disables recording entirely).
APO_TOOL_METRICS="${APO_TOOL_METRICS:-1}"
# Metrics store: embedded (DuckDB) | otlp (Jaeger spans) | both (cutover) | none
# APO_METRICS_BACKEND="${APO_METRICS_BACKEND:-embedded}"
# OTLP traces endpoint (HTTP :4318 — Workbench `just telemetry up`). Per-vault override:
# system/contracts/telemetry-contract.schema.yaml → store.backend / store.endpoint
# APO_OTLP_ENDPOINT="${APO_OTLP_ENDPOINT:-http://localhost:4318/v1/traces}"
# Legacy additive forwarder (otel extra) — disable when using store.backend otlp|both:
# APO_OTEL_EXPORT="${APO_OTEL_EXPORT:-0}"
APO_INGEST_DIR="${APO_INGEST_DIR:-resources/wiki}"

# --- Multi-vault discovery (preferred) ---
# Parent directory of vaults (autoconfigure). Not a queue/telemetry id.
# Each immediate child with usage-contract vault_id is registered; Wiki-like
# siblings without vault_id are skipped.
# APO_COLLECTION_ROOT="$HOME/Notes"
# APO_DEFAULT_VAULT=atlas
#
# Workbench / non-sibling roots — explicit paths only (never COLLECTION_ROOT=~/Notes):
# APO_VAULT_PATHS="$HOME/Notes/Work:$HOME/Notes/Contracts:$HOME/Notes/Optima:$HOME/Workbench/compliance"
# APO_DEFAULT_VAULT=work
#
# APO_VAULTS JSON — roots only; keys/collection ignored; names come from
# usage-contract vault_id. Prefer COLLECTION_ROOT / VAULT_PATHS for ordinary
# (writable) vaults — APO_VAULTS is still how a read-only vault gets registered
# (apo-engine okf ingest writes this file).
# APO_VAULTS="$HOME/.apo/vaults.json"

# Desk placement scripts (`just desk-project-cursor` / `desk-project-claude`) render
# against this vaults.json instead of the discovery vars above — point it at the
# registry your MCP host actually serves (Workbench: harness/mcp/vaults.workbench.json).
# APO_DESK_REGISTRY=/absolute/path/to/vaults.json

# Search quality (see docs/search-quality.md)
# Prefer per-vault system/contracts/search-contract.schema.yaml (default_exclude).
# APO_SEARCH_EXCLUDE="${APO_SEARCH_EXCLUDE:-}"

# Dotenv note: `just dotenv-load` does **not** expand ${HOME} / $HOME inside values.
# Prefer absolute paths in `.env`, or export vars from your shell profile.

# Watcher — MCP and watch must share the same discovery env.
APO_ENGINE_BIN="${APO_ENGINE_BIN:-$HOME/.local/bin/apo-engine}"
WATCH_INTERVAL="${WATCH_INTERVAL:-30}"
WATCH_RECONCILE_INTERVAL="${WATCH_RECONCILE_INTERVAL:-900}"
WATCH_PID_DIR="${WATCH_PID_DIR:-$HOME/.apo}"

# Local RPC (Laravel gateway / non-stdio clients) — see docs/local-rpc.md
# APO_RPC_HOST=127.0.0.1
# APO_RPC_PORT=8765
# APO_RPC_TOKEN=
# APO_RPC_SOCKET=
